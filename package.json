{
  "name": "pi-inline-skill",
  "version": "1.0.0",
  "description": "Invoke pi skills anywhere in a prompt with /skill:name, with inline name completion.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "skills"
  ],
  "pi": {
    "extensions": [
      "./inline-skill.ts"
    ]
  },
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "test": "node --import ./test/hooks.mjs --test test/inline-skill.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.6.1",
    "@earendil-works/pi-tui": "^1.6.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
